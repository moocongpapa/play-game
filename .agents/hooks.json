{
  "credit-and-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/scripts/pre-tool-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "quality-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/scripts/stop-quality-gate.mjs\"",
        "timeout": 20
      }
    ]
  }
}
