# Server-only: never prefix these provider keys with VITE_.
# Optional for gameplay: bundled audio and device speech work without keys.
ELEVENLABS_API_KEY=
# Used by the manual portrait-video tool; legacy Gemini-only TTS also uses this.
GEMINI_API_KEY=

# Optional shared quota for the deployed /api/speech endpoint (configure both).
# Required for deployed Gemini-only TTS. Local Vite uses in-memory counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional maintainer tool overrides, not needed to run the app.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# CARE_FFMPEG=/absolute/path/to/ffmpeg
# DISABLE_HMR=true
