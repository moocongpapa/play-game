# AI Voice TTS: server only. Set locally in .env.local and in your deployment's server environment.
# Never use a VITE_ prefix for these keys.
# Preferred: Free or Starter included credits, with usage-based billing OFF.
# Key permissions must allow reading subscription limits and generating speech/SFX.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
# Legacy Gemini-only installations; ignored when an ElevenLabs key is configured.
GEMINI_API_KEY=""

# Optional extra abuse protection for verified ElevenLabs included credits.
# Required for Gemini-only deployed instances. A configured Redis outage blocks generation.
# Local Vite development uses a bounded in-memory limiter instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Frontend (Vercel) & Backend (Render) Migration Config ---
# Backend REST API & SSE Server Endpoint
VITE_API_URL="https://clover-backend-vm9k.onrender.com"

# Supabase (PostgreSQL Database) connection properties
# Host: aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Firebase Config (yuha-game Project)
VITE_FIREBASE_API_KEY="AIzaSyA-vY3rgWWyD2agQjSili3X3fUCDcHNxxc"
VITE_FIREBASE_AUTH_DOMAIN="yuha-game.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="yuha-game"
VITE_FIREBASE_STORAGE_BUCKET="yuha-game.firebasestorage.app"
