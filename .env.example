# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Frontend (Vercel) & Backend (Render) Migration Config ---
# Backend REST API & SSE Server Endpoint
VITE_API_URL="https://clover-backend-vm9k.onrender.com"

# Supabase (PostgreSQL Database) connection properties
# Host: aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Firebase Config (clover-e3338 Project - Storage & Web Push)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="clover-e3338.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="clover-e3338"
VITE_FIREBASE_STORAGE_BUCKET="clover-e3338.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FCM_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

